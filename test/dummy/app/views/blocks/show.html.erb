<%= lc_docs_shell navigation: render("showcase/navigation"), menu_label: "Components" do %>
<div class="<%= lc_stack_class(gap: :section) %>">
  <header class="<%= lc_stack_class(gap: :heading, extra: "max-w-3xl") %>">
    <%= lc_breadcrumb [ [ "Blocks", blocks_path ], @block.title ] %>
    <%= lc_heading @block.title, level: 1, size: :title %>
    <p class="<%= lc_text_class(tone: :muted, extra: "text-pretty") %>"><%= @block.description %></p>
  </header>
  <section class="<%= lc_stack_class %>" aria-label="Interactive preview" data-controller="block-stage">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex gap-1 rounded-full bg-muted p-1" role="group" aria-label="Preview width">
        <%= lc_button "Desktop", variant: :ghost, size: :sm, class: "aria-pressed:bg-background", aria: { pressed: true }, data: { block_stage_target: "width", action: "block-stage#resize", width: "desktop" } %>
        <%= lc_button "Mobile", variant: :ghost, size: :sm, class: "aria-pressed:bg-background", aria: { pressed: false }, data: { block_stage_target: "width", action: "block-stage#resize", width: "mobile" } %>
      </div>
      <%= lc_button_link_to "Open preview ↗", @block.preview_url, variant: :ghost, size: :sm, target: "_blank", rel: "noopener" %>
    </div>
    <div class="flex justify-center overflow-hidden rounded-3xl bg-muted p-3 sm:p-5">
      <iframe src="<%= @block.preview_url %>" title="<%= @block.title %> interactive preview" class="h-[40rem] w-full rounded-2xl bg-background shadow-sm" data-block-stage-target="frame"></iframe>
    </div>
    <p class="text-xs text-muted-foreground">Interact with the example above, or open it in a full window.</p>
  </section>
  <%= lc_section title: "Make it yours", id: "adapt-title", anchor: true do %>
    <p class="<%= lc_text_class(size: :small, tone: :muted, extra: "max-w-3xl") %>">After <a href="<%= installation_path %>" class="<%= lc_link_class %>">setting up the library</a>, copy the example files into your app and adapt the content. These are composition references, with no block API to install or import.</p>
    <% if @block.stylesheet? || @block.controller? %>
      <p class="<%= lc_text_class(size: :small, tone: :muted, extra: "max-w-3xl") %>">Load the copied stylesheet from your application layout. Place the controller in your Stimulus controller directory and register it using your app's usual loading convention.</p>
    <% end %>
    <% @block.notes.each do |note| %><p class="<%= lc_text_class(size: :small, tone: :muted, extra: "max-w-3xl") %>"><%= note %></p><% end %>
    <div class="flex flex-wrap items-center gap-2 text-sm">
      <span class="text-muted-foreground">Built with</span>
      <% @block.components.each do |component| %>
        <% section = @sections.find { |section| section.id == component } %>
        <%= lc_button_link_to section.title, component_path(component), variant: :secondary, size: :sm %>
      <% end %>
    </div>
  <% end %>
  <%= lc_section title: "Example files", id: "files-title", anchor: true do %>
    <p class="<%= lc_text_class(size: :small, tone: :muted) %>">The preview renders this ERB and loads these styles and interactions.</p>
    <%= lc_stack gap: :section do %>
      <% @block.sources.each_with_index do |source, index| %>
        <div class="<%= lc_stack_class(gap: :heading) %>">
          <h3 class="break-all font-mono text-sm text-muted-foreground"><%= source.label %></h3>
          <%= render "showcase/source_code", source: source.content, language: source.language, id: "block-file-#{index}", label: source.label %>
        </div>
      <% end %>
    <% end %>
  <% end %>
  <%= lc_link "← All blocks", blocks_path, class: "self-start text-label no-underline hover:underline" %>
</div>
<% end %>
