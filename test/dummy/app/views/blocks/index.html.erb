<main id="main" class="<%= lc_stack_class(gap: :section, extra: "mx-auto max-w-330 px-5 pb-12 pt-12 sm:px-8 sm:pt-20 lg:px-10") %>">
  <header class="<%= lc_stack_class(gap: :heading) %>">
    <%= lc_heading "Blocks", level: 1, size: :title %>
    <p class="<%= lc_text_class(tone: :muted) %>">Ready-made layouts built with our components.</p>
  </header>

  <% @blocks.each do |block| %>
    <section id="<%= block.id %>" class="<%= lc_stack_class(gap: :heading, extra: "lc-anchor-target") %>" aria-labelledby="<%= block.id %>-title" data-controller="block-stage">
      <div class="<%= lc_section_header_class %>">
        <h2 id="<%= block.id %>-title" class="<%= lc_heading_class(extra: "w-full sm:me-auto sm:w-auto") %>"><%= block.title %></h2>
        <div class="flex gap-1 rounded-full bg-muted p-1" role="group" aria-label="Preview width">
          <%= lc_button "Desktop", variant: :ghost, size: :sm, class: "aria-pressed:bg-background", aria: { pressed: true }, data: { block_stage_target: "width", action: "block-stage#resize", width: "desktop" } %>
          <%= lc_button "Mobile", variant: :ghost, size: :sm, class: "aria-pressed:bg-background", aria: { pressed: false }, data: { block_stage_target: "width", action: "block-stage#resize", width: "mobile" } %>
        </div>
        <%= lc_button_link_to "Code", "#{block.url}#files-title", variant: :ghost, size: :sm, aria: { label: "#{block.title} source code" } %>
        <%= link_to block.preview_url, class: lc_icon_button_class(size: :sm, shape: :circle), aria: { label: "Open #{block.title} preview" }, target: "_blank", rel: "noopener" do %>
          <%= lc_icon "arrow-up-right", options: { "aria-hidden": true } %>
        <% end %>
      </div>
      <div class="flex justify-center overflow-hidden rounded-3xl bg-muted p-2 sm:p-3">
        <iframe src="<%= block.preview_url %>" title="<%= block.title %> interactive preview" class="h-[40rem] max-h-[75svh] min-h-96 w-full rounded-2xl bg-background" loading="lazy" data-block-stage-target="frame"></iframe>
      </div>
    </section>
  <% end %>
</main>
