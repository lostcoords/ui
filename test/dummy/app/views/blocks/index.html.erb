<main id="main" class="mx-auto flex max-w-330 flex-col gap-12 px-5 pb-12 pt-12 sm:gap-16 sm:px-8 sm:pt-20 lg:px-10">
  <header class="flex flex-col gap-4">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-6xl">Blocks</h1>
    <p class="text-lg text-ink-2">Ready-made layouts built with our components.</p>
  </header>

  <% @blocks.each do |block| %>
    <section id="<%= block.id %>" class="flex min-w-0 scroll-mt-28 flex-col gap-4" aria-labelledby="<%= block.id %>-title" data-controller="block-stage">
      <div class="flex flex-wrap items-center gap-3">
        <h2 id="<%= block.id %>-title" class="w-full text-xl font-semibold tracking-tight sm:me-auto sm:w-auto"><%= block.title %></h2>
        <div class="flex gap-1 rounded-full bg-paper-2 p-1" role="group" aria-label="Preview width">
          <%= ui_button "Desktop", variant: :ghost, size: :sm, class: "aria-pressed:bg-paper", aria: { pressed: true }, data: { block_stage_target: "width", action: "block-stage#resize", width: "desktop" } %>
          <%= ui_button "Mobile", variant: :ghost, size: :sm, class: "aria-pressed:bg-paper", aria: { pressed: false }, data: { block_stage_target: "width", action: "block-stage#resize", width: "mobile" } %>
        </div>
        <%= ui_button_link_to "Code", "#{block.url}#files-title", variant: :ghost, size: :sm, aria: { label: "#{block.title} source code" } %>
        <%= link_to block.preview_url, class: icon_button_class(size: :sm, shape: :circle), aria: { label: "Open #{block.title} preview" }, target: "_blank", rel: "noopener" do %>
          <%= heroicon "arrow-up-right", options: { "aria-hidden": true } %>
        <% end %>
      </div>
      <div class="flex justify-center overflow-hidden rounded-3xl bg-paper-2 p-2 sm:p-3">
        <iframe src="<%= block.preview_url %>" title="<%= block.title %> interactive preview" class="h-[40rem] max-h-[75svh] min-h-96 w-full rounded-2xl bg-paper" loading="lazy" data-block-stage-target="frame"></iframe>
      </div>
    </section>
  <% end %>
</main>
