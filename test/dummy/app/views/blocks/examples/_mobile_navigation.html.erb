<div class="min-h-screen" data-controller="blocks-mobile-navigation">
  <header class="mx-auto flex max-w-2xl items-center justify-between gap-4 px-5 pt-7 pb-6 sm:px-8">
    <a href="#projects" class="flex min-h-11 items-center gap-2 font-semibold" data-action="blocks-mobile-navigation#home"><%= lc_icon "square-3-stack-3d", options: { class: "size-5", "aria-hidden": true } %> Studio</a>
    <%= lc_avatar "AL", class: "bg-primary-soft text-primary", aria: { label: "Alex Lee" } %>
  </header>

  <main class="isolate mx-auto flex max-w-2xl flex-col gap-7 px-5 pt-3 sm:px-8">
    <div class="flex flex-col gap-2"><%= lc_text "A space to make things", size: :caption, tone: :muted %><h1 class="text-4xl font-semibold tracking-tight">Your little studio.</h1><p class="text-muted-foreground">A few good ideas, and room for a few more.</p></div>
    <p class="text-sm text-muted-foreground" role="status" aria-live="polite" data-blocks-mobile-navigation-target="status"></p>

    <section id="projects" class="flex flex-col gap-4" data-blocks-mobile-navigation-target="panel">
      <div class="flex min-h-11 items-center justify-between gap-3"><h2 class="text-xl font-semibold">On your desk</h2><%= lc_badge "This week" %></div>
      <div class="flex flex-col gap-4" data-blocks-mobile-navigation-target="projects">
        <% [ [ "Brand refresh", "Finding a fresh perspective.", "swatch", :primary, "In progress" ], [ "Field notes", "Small observations, collected.", "book-open", :success, "Taking shape" ], [ "Summer collection", "Objects for everyday moments.", "sun", :neutral, "Just getting started" ] ].each do |title, description, icon, tone, status| %>
          <%= lc_card class: "flex flex-col gap-content" do %>
            <div class="flex items-center justify-between gap-3"><%= lc_icon_badge shape: :circle, icon: icon, size: :lg, tone: tone%><%= lc_badge status %></div>
            <div class="flex flex-col gap-1"><h3 class="text-lg font-semibold"><%= title %></h3><p class="text-sm text-muted-foreground"><%= description %></p></div>
            <div class="flex items-center gap-2 text-sm text-muted-foreground"><%= lc_avatar "AL", size: :sm, class: "bg-background text-muted-foreground" %><span>You and your collaborators</span></div>
          <% end %>
        <% end %>
      </div>
    </section>

    <section id="notes" class="flex flex-col gap-4" data-blocks-mobile-navigation-target="panel" hidden>
      <h2 class="text-xl font-semibold">Notes to self</h2>
      <div class="flex flex-col gap-4" data-blocks-mobile-navigation-target="notes">
        <%= lc_card class: "flex flex-col gap-3" do %><%= lc_text "A thought for today", size: :caption, tone: :muted %><h3 class="text-lg font-semibold">Leave a little room.</h3><p class="text-sm text-muted-foreground">The best ideas sometimes arrive between the things you planned.</p><% end %>
      </div>
      <%= lc_field label: "Capture a thought", id: "studio-thought", hint: "A small idea is a good place to start." do |field| %><%= lc_textarea name: "thought", placeholder: "What’s on your mind?", rows: 4, **field %><% end %>
    </section>

    <section id="people" class="flex flex-col gap-4" data-blocks-mobile-navigation-target="panel" hidden>
      <h2 class="text-xl font-semibold">Good company</h2>
      <%= lc_card class: "flex flex-col gap-content" do %>
        <% [ [ "AL", "Alex Lee", "Designer" ], [ "SK", "Sam Kim", "Writer" ], [ "JR", "Jamie Reed", "Maker" ] ].each do |initials, name, role| %>
          <div class="flex items-center gap-3"><%= lc_avatar initials, class: "bg-background text-muted-foreground" %><div class="flex-1"><h3 class="text-sm font-semibold"><%= name %></h3><p class="text-sm text-muted-foreground"><%= role %></p></div><%= lc_badge "Available", tone: :primary, class: "rounded-full text-sm" %></div>
        <% end %>
      <% end %>
    </section>
  </main>

  <%= lc_dock do |dock| %>
    <%= dock.nav label: "Studio sections" do |nav| %>
      <% [ [ "Projects", "projects", "rectangle-stack" ], [ "Notes", "notes", "document-text" ], [ "People", "people", "users" ] ].each do |label, id, icon| %>
        <%= nav.link label, "##{id}", icon:, current: id == "projects", data: { action: "blocks-mobile-navigation#select" } %>
      <% end %>
    <% end %>
    <%= dock.menu label: "Create something", id: "studio-create-menu" do |menu| %>
      <%= menu.action "New project", icon: "rectangle-stack", data: { action: "blocks-mobile-navigation#add", blocks_mobile_navigation_destination_param: "projects" } %>
      <%= menu.action "Add a note", icon: "pencil-square", data: { action: "blocks-mobile-navigation#add", blocks_mobile_navigation_destination_param: "notes" } %>
    <% end %>
  <% end %>

  <template data-blocks-mobile-navigation-target="draft">
    <%= lc_card class: "flex flex-col gap-3" do %><%= lc_badge "Draft" %><h3 class="text-lg font-semibold" data-draft-title></h3><p class="text-sm text-muted-foreground">A fresh start. Make it your own.</p><% end %>
  </template>
</div>
