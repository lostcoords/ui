<div class="mx-auto flex max-w-360 gap-10 px-5 sm:px-8 lg:px-10">
  <%= render "showcase/sidebar" %>
  <main id="main" class="min-w-0 flex-1 py-5 lg:py-10">
    <%= render "showcase/mobile_navigation" %>
    <div class="flex flex-col gap-12 pt-6 lg:pt-0">
      <header class="flex flex-col gap-4">
        <div class="flex items-center justify-between gap-4">
          <p class="text-xs text-ink-3">Components <span class="px-2" aria-hidden="true">/</span> <%= @section.title %></p>
          <% position = @sections.index(@section) %>
          <div class="flex gap-1">
            <% [ [ position - 1, "Previous", "arrow-left" ], [ position + 1, "Next", "arrow-right" ] ].each do |index, label, icon| %>
              <% if index >= 0 && index < @sections.size %>
                <%= ui_button_link_to "/components/#{@sections[index].id}.html", variant: :ghost, size: :sm, aria: { label: "#{label} component: #{@sections[index].title}" } do %><%= heroicon icon, options: { "aria-hidden": true } %><% end %>
              <% end %>
            <% end %>
          </div>
        </div>
        <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl"><%= @section.title %></h1>
        <p class="text-base text-ink-2"><%= Showcase.description(@section.id) %></p>
      </header>
      <div class="flex flex-col gap-12">
        <% @section.examples.each_with_index do |example, index| %>
          <%= render "showcase/example", example:, id: "example-#{index}", title: showcase_title(example, index) %>
        <% end %>
      </div>
      <%= render "showcase/api", section: @section %>
    </div>
  </main>
  <aside class="sticky top-20 hidden h-[calc(100dvh-5rem)] w-40 shrink-0 overflow-y-auto py-12 text-xs xl:block">
    <p class="pb-4 font-medium">On this page</p>
    <nav class="flex flex-col items-start gap-3 text-ink-3" aria-label="On this page">
      <% @section.examples.each_with_index do |example, index| %>
        <a class="hover:text-ink" href="#example-<%= index %>"><%= showcase_title(example, index) %></a>
      <% end %>
      <a class="pt-2 hover:text-ink" href="#api">API reference</a>
    </nav>
  </aside>
</div>
