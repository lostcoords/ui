<% position = @sections.index(@section) %>
<% neighbor = ->(index) { (page = @sections[index]) && index >= 0 ? [ page.title, "/components/#{page.id}.html" ] : nil } %>
<% pages = { previous: neighbor.(position - 1), next: neighbor.(position + 1) } %>
<% contents = lc_toc do |toc| %>
  <% if @section.id == :foundations %>
    <%= toc.link "Roles and layout", "#roles" %>
    <%= toc.link "Reading styles", "#reading" %>
    <%= toc.link "Theme colors", "#tokens" %>
    <%= toc.link "Style settings", "#style-settings" %>
    <%= toc.link "Motion", "#motion-feedback" %>
  <% end %>
  <%= toc.link "Usage", "#usage" %>
  <%= toc.link "Examples", "#examples" %>
  <% @section.examples.each_with_index do |example, index| %>
    <%= toc.link showcase_title(example, index), "#example-#{index}", indent: true %>
  <% end %>
  <%= toc.link "API reference", "#api" %>
<% end %>
<%= lc_docs_shell navigation: render("showcase/navigation"), contents:, menu_label: "Components" do %>
<div class="<%= lc_stack_class(gap: :section) %>">
  <header class="<%= lc_stack_class(gap: :heading) %>">
    <div class="flex items-center justify-between gap-4">
      <%= lc_breadcrumb [ [ "Components", "/" ], @section.title ] %>
      <%= lc_pager **pages, label: "Components", compact: true %>
    </div>
    <%= lc_heading @section.title, level: 1, size: :title %>
    <p class="<%= lc_text_class(tone: :muted, extra: "text-pretty") %>"><%= Showcase.description(@section.id) %></p>
  </header>
  <%= render "showcase/foundations" if @section.id == :foundations %>
  <%= render "showcase/motion" if @section.id == :foundations %>
  <%= render "showcase/copy_button" if @section.id == :copy_button %>
  <%= lc_section title: "Usage", id: "usage", anchor: true do %>
    <p class="<%= lc_text_class(size: :small, tone: :muted, extra: "text-pretty") %>">After the <a href="/installation.html" class="<%= lc_link_class %>">one-time setup</a>, call the helper directly from ERB. No component import is needed.</p>
    <%= render "showcase/source_code", source: showcase_source(@section.examples.first, id: "my-component"), id: "usage-code", label: "#{@section.title} usage" %>
  <% end %>
  <%= lc_section title: "Examples", id: "examples", anchor: true do %>
    <%= lc_stack gap: :section do %>
      <% @section.examples.each_with_index do |example, index| %>
        <%= render "showcase/example", example:, id: "example-#{index}", title: showcase_title(example, index) %>
      <% end %>
    <% end %>
  <% end %>
  <%= render "showcase/api", section: @section %>
  <%= lc_pager **pages, label: "Components" %>
</div>
<% end %>
