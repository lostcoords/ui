<main id="main" class="<%= lc_stack_class(gap: :section, extra: "mx-auto max-w-330 gap-10 px-5 pb-12 pt-10 sm:gap-12 sm:px-8 sm:pt-16 lg:px-10") %>">
  <header class="<%= lc_stack_class(gap: :content, extra: "items-start gap-6") %>">
    <div class="<%= lc_stack_class(gap: :content) %>">
      <%= lc_heading "Components for Rails.", level: 1, size: :title, class: "text-4xl leading-tight sm:text-5xl" %>
      <p class="<%= lc_text_class(tone: :muted, extra: "max-w-lg text-pretty") %>">Render complete components from Ruby. Customize the included theme.</p>
    </div>
    <%= lc_button_link_to "Browse components", "/components/button.html", icon: "arrow-up-right", icon_position: :end %>
  </header>

  <%= render "showcase/component_bento", sections: @sections %>

  <div class="flex flex-wrap items-center justify-between gap-4 pt-4 text-sm">
    <p class="text-muted-foreground">Build with your own palette and type.</p>
    <%= lc_link "Customize the theme →", "/theming.html", class: "text-label" %>
  </div>
</main>
