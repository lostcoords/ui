<%= lc_nav_list label: "Documentation" do |nav| %>
  <%= nav.group "Library" do %>
    <%= nav.link "Overview", "/" %>
    <%= nav.link "Installation", "/installation.html", current: action_name == "installation" %>
    <%= nav.link "Theming", "/theming.html", current: action_name == "theming" %>
    <%= nav.link "Blocks", "/blocks.html", current: controller_name == "blocks" %>
    <%= nav.link "Foundations", "/components/foundations.html", current: @section&.id == :foundations %>
  <% end %>
  <%= nav.group "Components" do %>
    <% @sections.each do |section| %>
      <% next if section.id == :foundations %>
      <%= nav.link section.title, "/components/#{section.id}.html", current: @section&.id == section.id %>
    <% end %>
  <% end %>
<% end %>
