<%= ui_stack gap: :section do %>
  <%= ui_section title: "Choose a role, then arrange the content" do %>
    <%= ui_text tone: :muted do %>
      Text styles pair size, line height, weight and tracking. Heading level describes the document structure;
      <code>size:</code> describes its appearance. Parents set space between children with stacks, inline groups and sections.
    <% end %>
    <div class="grid gap-4 sm:grid-cols-2">
      <%= ui_card do %>
        <%= ui_stack gap: :related do %>
          <%= ui_heading "Text roles", size: :card, level: 3 %>
          <dl class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
            <% [ ["Page title", "30 / 36"], ["Section title", "20 / 24"], ["Card title", "18 / 24"], ["Body", "16 / 24"], ["Small", "14 / 20"], ["Caption", "12 / 16"] ].each do |role, value| %>
              <dt><%= role %></dt><dd class="text-end tabular-nums text-ink-2"><%= value %></dd>
            <% end %>
          </dl>
          <%= ui_text "Font size / line height in pixels at the default browser size. Values use rem units.", size: :caption, tone: :subtle %>
        <% end %>
      <% end %>
      <%= ui_card do %>
        <%= ui_stack gap: :related do %>
          <%= ui_heading "Spacing roles", size: :card, level: 3 %>
          <dl class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
            <% [ ["tight", "4"], ["related", "8"], ["heading", "12"], ["content", "16"], ["inset", "20"], ["section", "32"] ].each do |role, value| %>
              <dt><code><%= role %></code></dt><dd class="text-end tabular-nums text-ink-2"><%= value %>px</dd>
            <% end %>
          </dl>
          <%= ui_text "A section leaves 12px below its heading and 16px between its content blocks. Stack sections with gap: :section.", size: :caption, tone: :subtle %>
        <% end %>
      <% end %>
    </div>
  <% end %>
  <%= ui_section title: "Use reading styles for articles" do %>
    <%= ui_text tone: :muted do %>
      <code>ui_prose</code> styles rendered HTML with a 65ch reading measure, 1.75 line height and proportional block spacing.
      Enable <code>@plugin "@tailwindcss/typography";</code> in the host Tailwind input. The standalone Rails CLI includes the plugin.
      Mark embedded controls or cards <code>not-prose</code> to keep their component styles.
    <% end %>
  <% end %>
  <%= ui_section title: "Keep the rhythm, choose your fonts" do %>
    <%= ui_text tone: :muted do %>
      The engine import includes the foundation styles. Your app supplies its fonts and colours.
      Override the <code>--ui-*</code> custom properties in the host theme or on a container to tune a context.
      For example, <code>--ui-space-section: 2.5rem</code> changes section stacks;
      <code>--ui-heading-page-size: 2rem</code> changes page titles.
      Containers provide page, reading and form widths. Japanese examples inherit their language from <code>lang="ja"</code>.
    <% end %>
  <% end %>
<% end %>
