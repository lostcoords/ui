<%= lc_section title: "API reference", id: "api", class: "scroll-mt-28" do %>
  <p class="text-sm text-muted-foreground">Helpers render semantic HTML and include their interaction wiring. Pass native attributes through <code>class:</code>, <code>data:</code>, <code>aria:</code> and the usual Rails options. Blocks use captured ERB content.</p>
  <%= lc_stack gap: :section do %>
    <% showcase_builders(section).each do |component| %>
      <div class="<%= lc_stack_class %>">
        <h3 id="<%= component.name %>" class="scroll-mt-28 font-mono text-sm font-medium"><%= component.name %></h3>
        <%= render "showcase/source_code", source: component.signature, id: "#{component.name}-signature", language: :ruby, label: "#{component.name} signature" %>
        <div class="overflow-x-auto">
          <%= lc_table class: "min-w-80" do %>
            <thead><tr><th scope="col">Input</th><th scope="col">Default</th><th scope="col">Values</th></tr></thead>
            <tbody>
              <% showcase_parameters(component).each do |name, default| %>
                <tr><td class="align-top font-mono text-xs"><%= name %></td><td class="align-top font-mono text-xs"><%= default %></td><td class="align-top text-xs text-muted-foreground"><%= showcase_choices(component, name) %></td></tr>
              <% end %>
            </tbody>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
  <%= lc_card do |card| %>
    <%= card.header title: "Styling and extension" %>
    <%= card.content class: "text-small text-muted-foreground" do %>
    <p>Use <code>class:</code> to merge utilities, native attributes for application behavior, and the <a href="/theming.html" class="<%= lc_link_class %>">theming guide</a> for the shared palette. For custom markup, the <a href="https://github.com/lostcoords/ui#advanced-style-composition" class="<%= lc_link_class %>">advanced class helpers</a> expose the same styles, including glass surfaces and class merging.</p>
    <p><a href="/api.json" class="<%= lc_link_class %>">API JSON</a> · <a href="/llms.txt" class="<%= lc_link_class %>">LLM reference</a></p>
    <% end %>
  <% end %>
<% end %>
