<%= lc_section title: "API reference", id: "api", anchor: true do %>
  <p class="text-sm text-muted-foreground">Helpers render semantic HTML and include their interaction wiring. Pass native attributes through <code>class:</code>, <code>data:</code>, <code>aria:</code> and the usual Rails options. Blocks use captured ERB content.</p>
  <%= lc_stack gap: :section do %>
    <% showcase_components(section).each do |component| %>
      <%= render "showcase/signature", id: component.name, name: component.name, title: component.name, signature: component.signature, definition: component.signature %>
      <% parts = DocsParts.for(component.name) %>
      <% if parts.any? %>
        <%= lc_stack gap: :content do %>
          <p class="text-sm text-muted-foreground"><code><%= component.name %></code> yields a builder, <code><%= parts.first.receiver %></code>, with these parts. Each part carries <code>data-slot</code> and merges <code>class:</code> and native attributes.</p>
          <% parts.each do |part| %>
            <%= render "showcase/signature", id: "#{part.receiver}-#{part.name}", name: part.name, title: "#{part.receiver}.#{part.name}", signature: part.signature, definition: part.definition, level: 4 %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <% related = showcase_related(section) %>
  <% if related.any? %>
    <p class="text-sm text-muted-foreground">The examples also use <%= to_sentence(related.map { |name, url| link_to(tag.code(name), url, class: lc_link_class) }).html_safe %>. Each is documented on its own page.</p>
  <% end %>
  <%= lc_card do |card| %>
    <%= card.header title: "Styling and extension" %>
    <%= card.content class: "text-small text-muted-foreground" do %>
    <p>Use <code>class:</code> to merge utilities, native attributes for application behavior, and the <a href="<%= theming_path %>" class="<%= lc_link_class %>">theming guide</a> for the shared palette. For custom markup, the <a href="https://github.com/lostcoords/ui#advanced-style-composition" class="<%= lc_link_class %>">advanced class helpers</a> expose the same styles, including glass surfaces and class merging.</p>
    <p><a href="/api.json" class="<%= lc_link_class %>">API JSON</a> · <a href="/llms.txt" class="<%= lc_link_class %>">LLM reference</a></p>
    <% end %>
  <% end %>
<% end %>
