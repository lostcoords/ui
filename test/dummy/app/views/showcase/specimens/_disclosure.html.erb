<details class="<%= classes[:value] %>" data-controller="disclosure" data-action="click->disclosure#toggle">
  <summary class="flex cursor-pointer list-none items-center justify-between gap-3 font-semibold">
    <span>Who can access this project?</span>
    <%= heroicon "chevron-down", variant: :mini, options: { class: "size-5 text-ink-3", "aria-hidden": "true" } %>
  </summary>
  <div class="pt-3 text-sm text-ink-2">
    <p>Only people you invite can open this project. You can change their access at any time.</p>
  </div>
</details>
