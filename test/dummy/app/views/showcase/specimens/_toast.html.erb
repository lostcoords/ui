<div class="flex flex-col items-center gap-3">
  <div class="<%= classes[:toast] %>" role="status"><%= classes[:icon] %><span>Changes saved</span></div>
  <button type="button" class="<%= classes[:trigger] %>" data-action="demo#toast">Show a live toast</button>
  <template data-demo-target="toast">
    <div class="<%= classes[:toast] %> pointer-events-auto" role="status" data-controller="toast"><%= classes[:icon] %><span>Changes saved</span></div>
  </template>
  <div class="pointer-events-none fixed inset-x-0 bottom-6 z-nav-popover flex justify-center" aria-live="polite" data-demo-target="toasts"></div>
</div>
