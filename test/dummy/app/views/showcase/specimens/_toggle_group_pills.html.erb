<%= lc_stack do %>
  <%= lc_toggle_group label: "Category", name: "category", value: "", variant: :pills do %>
    <%= lc_toggle_group_item "Leave unchanged", value: "" %>
    <%= lc_toggle_group_item "Food", value: "food" %>
    <%= lc_toggle_group_item "Transport", value: "transport" %>
    <%= lc_toggle_group_item "Lodging", value: "lodging" %>
  <% end %>
  <%= lc_toggle_group label: "Paid by", name: "payer", value: "ana", variant: :pills, scroll: true do %>
    <% %w[Ana Bruno Chiara Daisuke Emeka Farah Gustav].each do |name| %>
      <%= lc_toggle_group_item name, value: name.downcase %>
    <% end %>
  <% end %>
<% end %>
