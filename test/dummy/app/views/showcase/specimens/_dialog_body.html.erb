<div class="flex flex-col gap-4 p-5">
  <h2 id="<%= id %>-title" class="text-lg font-semibold"><%= title %></h2>
  <p class="text-ink-2"><%= body %></p>
  <div class="<%= classes[:actions] %>">
    <button type="button" class="<%= classes[:cancel] %>" data-action="<%= close %>">Cancel</button>
    <button type="button" class="<%= classes[:confirm] %>" data-action="<%= close %>"><%= confirm %></button>
  </div>
</div>
