<div class="relative" data-controller="row-menu confirm-dialog">
  <button type="button" class="<%= classes[:trigger] %>" aria-haspopup="menu" aria-expanded="false" aria-label="Actions"
    data-row-menu-target="trigger" data-action="row-menu#toggle"><%= heroicon "ellipsis-horizontal", options: { "aria-hidden": "true" } %></button>
  <div class="<%= classes[:menu] %>" role="menu" data-row-menu-target="popover">
    <button type="button" class="<%= classes[:option] %>" role="menuitem" data-action="confirm-dialog#open row-menu#close"><%= heroicon "trash", options: { class: "size-5", "aria-hidden": "true" } %><span>Delete…</span></button>
  </div>
  <dialog data-controller="sheet" data-sheet-detents-value="fit" class="<%= classes[:dialog] %>" aria-labelledby="<%= id %>-title" data-confirm-dialog-target="dialog">
    <div class="flex flex-col gap-4 p-5">
  <h2 id="<%= id %>-title" class="text-lg font-semibold">Delete this project?</h2>
  <p class="text-ink-2">Anchored to the menu that opened it.</p>
  <div class="<%= classes[:actions] %>">
    <button type="button" class="<%= classes[:cancel] %>" data-action="confirm-dialog#close">Cancel</button>
    <button type="button" class="<%= classes[:confirm] %>" data-action="confirm-dialog#close">Delete</button>
  </div>
</div>

  </dialog>
</div>
