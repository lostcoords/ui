<% card = capture do %>
  <span class="flex flex-col gap-related">
    <span class="flex items-center gap-heading">
      <%= lc_avatar "AL", size: :lg %>
      <span class="flex min-w-0 flex-col">
        <span class="truncate text-label font-semibold">Ada Lovelace</span>
        <span class="truncate text-small text-muted-foreground">@ada</span>
      </span>
    </span>
    <span class="text-small">Writes about analytical engines and the poetry of numbers.</span>
    <span class="text-small text-muted-foreground"><span class="font-semibold text-foreground">1,843</span> followers · <span class="font-semibold text-foreground">12</span> replies</span>
  </span>
<% end %>
<p class="text-body">
  Notes from
  <%= lc_hovercard content: card do |preview| %>
    <%= link_to "Ada Lovelace", "#ada", class: "font-semibold text-primary hover:underline", **preview %>
  <% end %>
  on the engine's first program.
</p>
