<div class="<%= classes[:stack] %>">
  <div class="<%= classes[:row] %>">
    <% { "AL" => "sky", "AN" => "leaf", "MO" => "berry", "+2" => "gold" }.each do |initials, color| %>
      <span class="<%= classes[:avatar] %>" style="background-color: var(--<%= color %>)"><%= initials %></span>
    <% end %>
  </div>
</div>
