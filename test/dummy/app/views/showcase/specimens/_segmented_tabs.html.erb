<div class="<%= classes[:bar] %>" role="tablist" aria-label="View">
  <% { "Overview" => true, "Activity" => false, "Members" => false }.each do |label, selected| %>
    <button type="button" class="<%= classes[:tab] %>" role="tab" aria-selected="<%= selected %>" data-action="demo#select"><%= label %></button>
  <% end %>
</div>

<div class="<%= classes[:bar] %>" role="group" aria-label="Audience">
  <% { "Everyone" => true, "By team" => false, "Custom" => false }.each do |label, selected| %>
    <button type="button" class="<%= classes[:tab] %>" aria-pressed="<%= selected %>" data-action="demo#choose"><%= label %></button>
  <% end %>
</div>
