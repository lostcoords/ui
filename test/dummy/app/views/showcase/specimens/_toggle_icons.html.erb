<%= lc_inline gap: :tight, role: "group", aria: { label: "Formatting" } do %>
  <%= lc_toggle "Bold", icon: "bold", icon_only: true, tooltip: true, active: true %>
  <%= lc_toggle "Italic", icon: "italic", icon_only: true, tooltip: true %>
  <%= lc_toggle "Underline", icon: "underline", icon_only: true, tooltip: true, size: :sm %>
  <%= lc_toggle "Pinned", icon: "bookmark" %>
<% end %>
