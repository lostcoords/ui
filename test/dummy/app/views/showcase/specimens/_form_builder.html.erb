<%= lc_form_with model: DocsProject.invalid_example, url: "#", card: true, class: "w-full max-w-sm" do |form| %>
  <%= form.field :name, hint: "Shown to members." %>
  <%= form.field :email, as: :email_field, size: :sm, label: "Email (compact)" %>
  <%= form.switch :public, hint: "Anyone with the link can view." %>
  <%= form.submit "Save project" %>
<% end %>
