<%= lc_inline gap: :content do %>
  <%= lc_tooltip "Copy a link to this page", id: "EXAMPLE_ID-copy-tip" do |tip| %>
    <%= lc_icon_button "Copy link", icon: "link", **tip %>
  <% end %>
  <%= lc_tooltip "Only owners can archive", id: "EXAMPLE_ID-archive-tip", side: :bottom do |tip| %>
    <%= lc_button "Archive", variant: :secondary, **tip %>
  <% end %>
<% end %>
