<section id="<%= id %>" class="flex min-w-0 scroll-mt-28 flex-col gap-4">
  <h2 class="group/heading text-xl font-semibold tracking-tight"><a href="#<%= id %>" class="inline-flex items-center gap-2"><%= title %><span class="text-ink-3 opacity-0 transition-opacity group-hover/heading:opacity-100 group-has-focus-visible/heading:opacity-100" aria-hidden="true">#</span></a></h2>
  <% if example.note %><p class="text-pretty text-sm text-ink-2"><%= example.note %></p><% end %>
  <div class="flex min-h-48 flex-wrap items-center justify-center gap-4 rounded-2xl p-6 sm:p-10 <%= example.stage == :page ? 'bg-paper' : 'bg-paper-2' %>" data-example-preview>
    <%= render inline: showcase_source(example, id:) %>
  </div>
  <%= render "showcase/source_code", source: showcase_source(example, id:), id: "#{id}-code", label: "#{title} code" %>
</section>
