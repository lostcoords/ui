<section id="<%= id %>" class="<%= lc_stack_class(gap: :heading, extra: "lc-anchor-target") %>">
  <%= lc_section_header do %><%= lc_heading title, level: 3, size: :subheading, anchor: id %><% end %>
  <%= lc_stack do %>
    <% if example.note %><p class="text-pretty text-sm text-muted-foreground"><%= example.note %></p><% end %>
    <%# The panel sets the context a card sets, so muted fills, choice tiles and avatar cutouts look as they do on a card. %>
    <div class="<%= example.stage == :panel ? 'flex min-h-48 flex-wrap items-center justify-center gap-4 rounded-2xl bg-muted p-6 sm:p-10 [--lc-tile-bg:var(--background)] [--lc-track-bg:var(--accent)] [--lc-avatar-cutout:var(--muted)]' : 'min-w-0' %>" data-example-preview data-stage="<%= example.stage %>">
      <%= render inline: showcase_source(example, id:) %>
    </div>
    <%= render "showcase/source_code", source: showcase_source(example, id:), id: "#{id}-code", label: "#{title} code" %>
  <% end %>
</section>
