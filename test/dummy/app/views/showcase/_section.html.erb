<section id="<%= section.id %>" class="flex scroll-mt-24 flex-col gap-3">
  <div class="flex flex-col gap-2">
    <h2 class="text-xl font-semibold"><%= section.title %></h2>
    <ul class="flex flex-wrap gap-x-4 gap-y-1">
      <% showcase_signatures(section).each do |signature| %>
        <li><code class="font-mono text-xs text-ink-3"><%= signature %></code></li>
      <% end %>
    </ul>
  </div>
  <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,17rem),1fr))] gap-4">
    <% section.examples.each_with_index do |example, index| %>
      <%= render "showcase/example", example:, id: "#{section.id}-#{index}" %>
    <% end %>
  </div>
</section>
