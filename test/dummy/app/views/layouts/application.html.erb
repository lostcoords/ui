<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="darkreader-lock">
    <title><%= @section ? "#{@section.title} · " : (@block ? "#{@block.title} · " : (controller_name == "blocks" ? "Blocks · " : "")) %>LOST COORDS UI</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="A Rails component library. Examples, ERB and API reference.">
    <link rel="icon" href="data:,">
    <script>
      const palette = localStorage.getItem("lostcoords-ui:palette")
      if (<%= raw DocsPalette::ALL.reject { |palette| palette.id == "original" }.map(&:id).to_json %>.includes(palette)) document.documentElement.dataset.palette = palette
      const theme = localStorage.getItem("lostcoords-ui:theme")
      if (theme === "dark" || (!theme && matchMedia("(prefers-color-scheme: dark)").matches)) document.documentElement.dataset.theme = "dark"
    </script>
    <%= stylesheet_link_tag "tailwind", "blocks/application_header", "blocks/docs_shell" %>
    <%= stylesheet_link_tag "components" if action_name == "components" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="antialiased" data-controller="showcase palette-split" data-action="submit->showcase#preventExampleSubmit palette-split:choose->showcase#choosePalette">
    <%= lc_skip_link %>
    <% brand = capture do %>
      <svg class="size-7" viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M7 3v18h18M3 7h18v18M14 9v10M9 14h10" stroke="currentColor" stroke-width="2"/></svg>
      <span class="text-sm">lostcoords<span class="text-muted-foreground"> / </span>ui</span>
    <% end %>
    <% links = [ [ "Docs", "/installation.html", action_name == "installation" ], [ "Foundations", "/components/foundations.html", @section&.id == :foundations ], [ "Components", "/components.html", action_name == "components" || (@section && @section.id != :foundations) ], [ "Blocks", "/blocks.html", controller_name == "blocks" ], [ "Theming", "/theming.html", action_name == "theming" ] ] %>
    <%= render layout: "blocks/examples/application_header", locals: { brand:, home_label: "LOST COORDS UI home", links:, width: "max-w-330", navigation_class: "lg:flex" } do %>
      <%= lc_icon_button "Switch color theme", icon: "moon", size: :sm, data: { action: "showcase#toggleTheme", showcase_target: "theme" }, aria: { pressed: false } %>
      <%= render "showcase/palette_picker" %>
      <%= lc_button_link_to "https://github.com/lostcoords/ui", variant: :ghost, size: :sm, class: "max-sm:hidden", aria: { label: "Source on GitHub" } do %><%= render "showcase/github_icon" %><% end %>
    <% end %>
    <%= yield %>
    <footer class="mx-auto flex max-w-360 flex-wrap items-center justify-between gap-4 px-5 py-10 text-xs text-muted-foreground sm:px-8 lg:px-10">
      <span>LOST COORDS UI</span><%= lc_link "Source on GitHub ↗", "https://github.com/lostcoords/ui", tone: :muted, class: "no-underline hover:underline" %>
    </footer>
    <%= render "showcase/palette_split" %>
  </body>
</html>
