<%# locals: (id:, title:, trigger:, attributes:, content:) %>
<div data-controller="modal">
  <button type="button" class="<%= lc_button_class(variant: :secondary) %>" aria-haspopup="dialog" aria-controls="<%= id %>" data-action="modal#open"><%= trigger %></button>
  <%= tag.dialog(**attributes) do %>
    <div class="flex flex-col gap-5 p-5">
      <div class="flex items-center justify-between gap-4">
        <h2 id="<%= id %>-title" class="text-xl font-semibold"><%= title %></h2>
        <button type="button" class="<%= lc_icon_button_class(size: :sm) %>" aria-label="Close <%= title %>" data-action="modal#close"><%= lc_icon "x-mark", options: { "aria-hidden": true } %></button>
      </div>
      <%= content %>
    </div>
  <% end %>
</div>
