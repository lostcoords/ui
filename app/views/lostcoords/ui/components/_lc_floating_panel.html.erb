<%# locals: (id:, title:, wrapper:, trigger:, attributes:, content:) %>
<% panel = tag.div(**attributes) do %>
  <% if title %><h2 id="<%= id %>-title" class="<%= lc_heading_class(size: :subheading) %>"><%= title %></h2><% end %>
  <%= content %>
<% end %>
<% if wrapper %>
  <%= tag.div(**wrapper) do %>
    <%= trigger %>
    <%= panel %>
  <% end %>
<% else %>
  <%= panel %>
<% end %>
