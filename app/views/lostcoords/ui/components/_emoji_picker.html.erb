<%# locals: (form:, field:, value: nil, quick: [], recent: [], recent_scope: nil, label:, catalog_url:, picker_class: nil, trigger_class: nil, popover_class: nil, auto_submit: false, attributes: {}) %>
<% quick = Array(quick).uniq
  recent = Array(recent).uniq
  selected = value.presence || form.object&.public_send(field).presence || quick.first || lc_emoji_picker_groups.first[:emojis].first
  selected_is_quick = quick.include?(selected)
  trigger_label = selected_is_quick ? "＋" : selected
  tone_modifiers = [ "", "🏻", "🏼", "🏽", "🏾", "🏿" ]
  tone_names = %w[default light medium_light medium medium_dark dark] %>

<%= tag.div(**lc_attributes({ class: lc_tw("lc-emoji-picker", picker_class), data: { controller: "lc-emoji-picker", lc_emoji_picker_auto_submit_value: auto_submit, lc_emoji_picker_catalog_url_value: catalog_url, lc_emoji_picker_recent_scope_value: recent_scope } }, attributes)) do %>
  <%= form.hidden_field field,
      value: selected,
      data: { lc_emoji_picker_target: "input" } %>

  <% quick.each do |emoji| %>
    <button
      type="button"
      class="lc-emoji-picker__choice"
      aria-current="<%= emoji == selected %>"
      data-emoji="<%= emoji %>"
      data-action="click->lc-emoji-picker#select"
    >
      <%= emoji %>
    </button>
  <% end %>

  <div class="lc-emoji-picker__more">
    <button
      type="button"
      class="lc-emoji-picker__trigger <%= trigger_class %>"
      aria-current="<%= !selected_is_quick %>"
      data-lc-emoji-picker-target="trigger"
      data-action="click->lc-emoji-picker#toggle"
      data-default-label="＋"
      data-value="<%= selected %>"
      aria-label="<%= label %>"
      aria-expanded="false"
    >
      <%= trigger_label %>
    </button>

    <div
      class="lc-emoji-picker__popover <%= popover_class %>"
      data-lc-emoji-picker-target="popover"
      data-controller="lc-sheet"
      data-action="click->lc-emoji-picker#select pointerover->lc-emoji-picker#preview focusin->lc-emoji-picker#preview lc-sheet:dismiss->lc-emoji-picker#close"
      role="dialog"
      aria-label="<%= label %>"
      hidden
    >
      <span class="lc-emoji-picker__handle" data-lc-sheet-target="handle" aria-hidden="true"></span>

      <div class="lc-emoji-picker__search">
        <div class="lc-emoji-picker__search-field">
          <svg class="lc-emoji-picker__search-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.6" />
            <path d="m14 14 3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>

          <input
            class="lc-emoji-picker__search-input"
            type="search"
            inputmode="search"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            enterkeyhint="search"
            aria-label="<%= lc_t("lostcoords.ui.emoji_picker.search_label") %>"
            placeholder="<%= lc_t("lostcoords.ui.emoji_picker.search_placeholder") %>"
            data-lc-emoji-picker-target="searchInput"
            data-action="input->lc-emoji-picker#filter keydown->lc-emoji-picker#onSearchKeydown"
          >
        </div>

        <div class="lc-emoji-picker__tones" data-lc-emoji-picker-target="tones">
          <button
            type="button"
            class="lc-emoji-picker__tone-toggle"
            data-lc-emoji-picker-target="toneToggle"
            data-action="click->lc-emoji-picker#toggleTones"
            aria-haspopup="true"
            aria-expanded="false"
            aria-label="<%= lc_t("lostcoords.ui.emoji_picker.skin_tone") %>"
          >✋</button>

          <div class="lc-emoji-picker__tone-menu <%= popover_class %>" data-lc-emoji-picker-target="toneMenu" data-action="keydown->lc-emoji-picker#navigateTones" role="menu" aria-label="<%= lc_t("lostcoords.ui.emoji_picker.skin_tone") %>" hidden>
            <% tone_modifiers.each_with_index do |modifier, index| %>
              <button
                type="button"
                class="lc-emoji-picker__tone"
                role="menuitemradio"
                data-tone-index="<%= index %>"
                data-action="click->lc-emoji-picker#selectTone"
                aria-label="<%= lc_t("lostcoords.ui.emoji_picker.skin_tones.#{tone_names[index]}") %>"
              >✋<%= modifier %></button>
            <% end %>
          </div>
        </div>
      </div>

      <nav class="lc-emoji-picker__tabs" data-lc-emoji-picker-target="tabs" data-action="keydown->lc-emoji-picker#navigateTabs" aria-label="<%= lc_t("lostcoords.ui.emoji_picker.categories_nav") %>">
        <% if recent.any? %>
          <button
            type="button"
            class="lc-emoji-picker__tab"
            data-lc-emoji-picker-target="tab"
            data-target-section="recent"
            data-action="click->lc-emoji-picker#jumpTo"
            aria-label="<%= lc_t("lostcoords.ui.emoji_picker.recently_used") %>"
          >🕘</button>
        <% end %>

        <% lc_emoji_picker_groups.each do |group| %>
          <button
            type="button"
            class="lc-emoji-picker__tab"
            data-lc-emoji-picker-target="tab"
            data-target-section="<%= group[:key] %>"
            data-action="click->lc-emoji-picker#jumpTo"
            aria-label="<%= group[:name] %>"
          ><%= group[:icon] %></button>
        <% end %>
      </nav>

      <div class="lc-emoji-picker__body" data-lc-emoji-picker-target="body" data-action="keydown->lc-emoji-picker#navigateGrid focusin->lc-emoji-picker#trackGridFocus">
        <% if recent.any? %>
          <section
            class="lc-emoji-picker__recent"
            data-section="recent"
            aria-label="<%= lc_t('lostcoords.ui.emoji_picker.recently_used') %>"
            data-lc-emoji-picker-target="recent"
          >
            <header class="lc-emoji-picker__category-head">
              <h3><%= lc_t("lostcoords.ui.emoji_picker.recently_used") %></h3>
              <span class="count"><%= recent.size %></span>
            </header>

            <div class="lc-emoji-picker__grid">
              <% recent.each do |emoji| %>
                <button
                  type="button"
                  aria-current="<%= emoji == selected %>"
                  data-emoji="<%= emoji %>"
                  data-search="<%= emoji %>"
                  data-search-name="<%= lc_emoji_picker_search_name(emoji) %>"
                  title="<%= lc_emoji_picker_search_name(emoji) %>"
                  aria-label="<%= lc_emoji_picker_search_name(emoji) %>"
                >
                  <%= emoji %>
                </button>
              <% end %>
            </div>
          </section>
        <% end %>

        <section class="lc-emoji-picker__results" data-lc-emoji-picker-target="results" aria-label="<%= lc_t('lostcoords.ui.emoji_picker.search_results') %>" hidden>
          <header class="lc-emoji-picker__category-head">
            <h3><%= lc_t("lostcoords.ui.emoji_picker.search_results") %></h3>
            <span class="count" data-lc-emoji-picker-target="resultsCount">0</span>
          </header>

          <div class="lc-emoji-picker__grid" data-lc-emoji-picker-target="resultsGrid"></div>
        </section>

        <p class="lc-emoji-picker__empty" data-lc-emoji-picker-target="empty" hidden>
          <%= lc_t("lostcoords.ui.emoji_picker.no_results") %>
        </p>
      </div>

      <footer class="lc-emoji-picker__preview" data-lc-emoji-picker-target="preview">
        <span class="lc-emoji-picker__preview-emoji" data-lc-emoji-picker-target="previewEmoji"><%= selected %></span>
        <span class="lc-emoji-picker__preview-name" data-lc-emoji-picker-target="previewName"><%= lc_emoji_picker_search_name(selected) %></span>
      </footer>
    </div>
  </div>
<% end %>
